# Database connection string
DATABASE_URL="postgresql://user:password@localhost:5432/node_react_starter_dev?sslmode=disable"

# Session configuration
SESSION_SECRET="replace-with-strong-secret"
SESSION_NAME="sessionId"
SESSION_MAX_AGE_HOURS=24

# Server configuration (optional)
PORT=3000

# Password given to the local sample-data accounts (npm run db:seed).
# Required by that script — it refuses to run without it. Local development
# only; these accounts must never exist in a deployed environment.
SAMPLE_DATA_PASSWORD=""
